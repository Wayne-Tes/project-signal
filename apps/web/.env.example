# Copy to apps/web/.env.local for local development. Never commit .env.local.
#
# These are NEXT_PUBLIC_* variables: Next.js inlines them into the client bundle at BUILD time.
# Setting them as runtime environment variables on a container has NO effect — in CI they must
# be passed as Docker build args. See docs/KNOWN-GAPS.md #8.
#
# The Cognito values are public by design: the pool id is an identifier and the client id is a
# PUBLIC OAuth client with no secret, because a browser cannot keep one. They are still required
# with no fallback — defaulting them would silently ship a bundle pointed at the wrong user pool,
# and a build-time inlined mistake is invisible until someone tries to sign in.
#
# Get the current values from Terraform rather than copying them from anywhere else:
#
#   terraform -chdir=infra-aws/stack output cognito_user_pool_id
#   terraform -chdir=infra-aws/stack output cognito_client_id
#   terraform -chdir=infra-aws/stack output alb_dns_name
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=

# Base URL of the API. Defaults to http://localhost:8080 when unset, which is what you want
# locally alongside `yarn dev`.
#
# In the deployed environment the web app and the API sit behind the SAME load balancer, so this
# is the ALB's own origin — same-origin, which means no CORS preflight and no CORS_ORIGINS
# allowlist to keep in step.
NEXT_PUBLIC_API_URL=http://localhost:8080
