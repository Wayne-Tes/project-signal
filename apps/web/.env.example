# Copy to apps/web/.env.local for local development. Never commit .env.local.
#
# These are NEXT_PUBLIC_* variables: Next.js inlines them into the client bundle at BUILD
# time. Setting them as runtime env vars on Cloud Run has no effect — in CI they must be
# passed as Docker build args. See docs/KNOWN-GAPS.md #8.
#
# The Firebase values are public by design (they identify the project, they don't authorise
# anything), but they are required with no fallback: defaulting them would silently ship a
# bundle pointed at the wrong Identity Platform project. The app throws at startup if any
# are missing.
#
# Get them from: Firebase console → Project settings → Your apps → Web app → SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=   # e.g. <project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Base URL of the API. Defaults to http://localhost:8080 when unset, which is what you
# want locally alongside `yarn dev`.
NEXT_PUBLIC_API_URL=http://localhost:8080
