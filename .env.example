# Copy to .env for local development. Never commit .env.
# In staging/production all values come from GCP Secret Manager.

# Database — matches docker-compose postgres service
DATABASE_URL="postgresql://project_signal_app:password@localhost:5432/project_signal"

# LocalStack — the docker-compose service that stands in for S3 and SQS locally.
# The AWS SDKs pick this up automatically; leave it UNSET in any deployed environment so the
# real regional endpoint resolves.
AWS_ENDPOINT_URL="http://localhost:4566"
AWS_REGION="eu-west-2"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"

# SQS queue URLs. Terraform injects the real ones per environment. There is deliberately no
# fallback constant: an SQS URL embeds the account id and region, so a guess would publish
# into nowhere — queueUrl() throws when these are unset.
ITEM_QUEUE_URL="http://localhost:4566/000000000000/psignal-local-item"
REPORT_QUEUE_URL="http://localhost:4566/000000000000/psignal-local-report"

# Cloud Storage bucket for raw ingested payloads. Required by ingestion and sentiment-worker —
# getObjectStore() throws without it. There is no local GCS emulator, so exercising the raw
# read/write path locally needs a real bucket and credentials.
RAW_BUCKET=
REPORTS_BUCKET=

# Vertex AI — not used locally, set for staging/production
VERTEX_AI_LOCATION="europe-west2"

# Model config — use-case names so the provider can be swapped without code changes.
# Both are 2.5 Flash because that is the only Gemini model available in europe-west2.
# Retires 2026-10-16 — see docs/SETUP.md §8 before that date.
SCORER_MODEL="gemini-2.5-flash"        # high-volume per-item sentiment scoring
REPORTER_MODEL="gemini-2.5-flash"      # low-volume weekly/daily report generation

# Ingestion adapter credentials — system-level, shared across all tenants.
# In production these come from GCP Secret Manager, not this file.
APIFY_API_KEY=
YOUTUBE_API_KEY=

# Apps
PORT=8080
NODE_ENV=development
LOG_LEVEL=debug

# Note: the web app does NOT read this file. Next.js reads apps/web/.env.local —
# see apps/web/.env.example for the NEXT_PUBLIC_* values it requires.
