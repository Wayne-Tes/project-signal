# ---------------------------------------------------------------------------------------------
# Project Signal — local development environment
#
#   cp .env.example .env
#
# Never commit .env. The values below are the working defaults for a local stack; the only
# things you may need to supply yourself are the two ingestion API keys at the bottom, and
# only if you want to pull from those sources.
#
# THE AUTHORITY ON THIS FILE IS `libs/config/src/index.ts`. That zod schema decides which
# variables exist, which are required, and what they default to. This file is documentation of
# it and is allowed to drift — if the two disagree, the schema wins and this file is the bug.
#
# apps/web does NOT read this file. Next.js reads apps/web/.env.local — see
# apps/web/.env.example for the NEXT_PUBLIC_* values it needs.
# ---------------------------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------------------------
# Matches the docker-compose postgres service. Migrations are applied by the API on startup;
# there is no migrate step, so BOOT THE API BEFORE SEEDING or you get
# `relation "tenants" does not exist`.
DATABASE_URL="postgresql://project_signal_app:password@localhost:5432/project_signal"

# The alternative connection mode: DB_SOCKET_PATH + DB_NAME + DB_USER + DB_PASSWORD. It exists
# only for the GCP Cloud SQL Auth Proxy, whose socket path contains colons that break postgres-js
# host parsing. RDS is plain TCP, so DATABASE_URL covers AWS. Leave these unset locally; delete
# them from the schema when RDS lands.
# DB_SOCKET_PATH=
# DB_NAME=project_signal
# DB_USER=project_signal_app
# DB_PASSWORD=

# --- AWS ---------------------------------------------------------------------------------------
# These are read by the AWS SDK's default credential/region chain, NOT by libs/config — which is
# why they do not appear in the zod schema. Deployed services get credentials from the ECS task
# role and set none of this.
#
# AWS_ENDPOINT_URL is what points the S3, SQS and Bedrock clients at LocalStack. It MUST be unset
# in any deployed environment or the SDK will not resolve the real regional endpoint.
AWS_ENDPOINT_URL="http://localhost:4566"
AWS_REGION="eu-west-2"
# LocalStack ignores credentials, but the SDKs refuse to sign a request without them.
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"

# ─────────────────────────────────────────────────────────────────────────────────────────────
# HYBRID MODE — local Postgres, REAL AWS services
# ─────────────────────────────────────────────────────────────────────────────────────────────
#
# LocalStack does not emulate Bedrock, so scoring cannot be exercised locally against it at all.
# Hybrid mode is how the scoring step gets proven without waiting for Fargate: keep Postgres in
# Docker, and point S3, SQS and Bedrock at the real dev account.
#
# To switch, in your shell (NOT by editing this file):
#
#   unset AWS_ENDPOINT_URL AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
#   export AWS_PROFILE=psignal-dev
#   export RAW_BUCKET=psignal-dev-raw-290304998906
#   export ITEM_QUEUE_URL=https://sqs.eu-west-2.amazonaws.com/290304998906/psignal-dev-item
#
# Unsetting the three matters. AWS_ENDPOINT_URL sends every client to LocalStack regardless of
# credentials, and the literal "test" keys shadow the SSO profile — either one alone silently
# defeats the switch.
#
# ⚠️ Hybrid mode writes to the REAL dev bucket and REAL dev queue. That is intended for proving
# the pipeline, but it is shared with whatever is deployed, so do not point it at anything you
# would mind polluting with test signals.
#
# Deployed values, for reference (Terraform injects these into the ECS task definitions; you do
# not set them by hand in a deployed environment):
#
#   RAW_BUCKET       psignal-dev-raw-290304998906
#   REPORTS_BUCKET   psignal-dev-reports-290304998906
#   ITEM_QUEUE_URL   https://sqs.eu-west-2.amazonaws.com/290304998906/psignal-dev-item
#   REPORT_QUEUE_URL https://sqs.eu-west-2.amazonaws.com/290304998906/psignal-dev-report
#   DATABASE_URL     from Secrets Manager psignal-dev-db-password, the `url` field

# --- S3 -----------------------------------------------------------------------------------------
# Raw ingested payloads. Required by ingestion and sentiment-worker — getObjectStore() throws a
# named error without it. scripts/localstack-init.sh creates this bucket on first boot.
RAW_BUCKET="psignal-local-raw"
# Generated reports. Unused until Epic 12.
REPORTS_BUCKET=

# --- SQS ----------------------------------------------------------------------------------------
# Full queue URLs, created by scripts/localstack-init.sh. Terraform injects the real ones per
# environment.
#
# There is deliberately NO fallback constant and no default: an SQS URL embeds the account id and
# region, so nothing generic could stand in for one, and a wrong guess publishes into a void.
# queueUrl() throws and names the missing variable. The old Pub/Sub design DID have a fallback
# constant, and the result was publishing to a topic that existed in no deployed environment while
# nothing failed — see KNOWN-GAPS #7.
ITEM_QUEUE_URL="http://localhost:4566/000000000000/psignal-local-item"
REPORT_QUEUE_URL="http://localhost:4566/000000000000/psignal-local-report"

# --- Bedrock (models) -----------------------------------------------------------------------------
# Named by USE CASE, not by provider, so the model can change without touching a call site.
#
# These are Bedrock INFERENCE PROFILE ids, not model ids. The bare
# `anthropic.claude-haiku-4-5-20251001-v1:0` is rejected with "on-demand throughput isn't
# supported". The `eu.` prefix keeps inference inside the EU; `global.` profiles exist for the
# same models and do not.
#
# Verified live in eu-west-2 on 2026-08-07. Model availability is account-specific and decays —
# confirm with `aws bedrock list-inference-profiles --region eu-west-2` before changing these.
# NEVER write a model id from memory; this repo has already shipped a retired one and one that
# never existed.
#
# NOTE: LocalStack does not emulate Bedrock. Scoring against a real model needs real AWS
# credentials, so the local stack proves ingest → S3 → SQS but not the scoring step.
SCORER_MODEL="eu.anthropic.claude-haiku-4-5-20251001-v1:0"    # high-volume, one review per call
REPORTER_MODEL="eu.anthropic.claude-haiku-4-5-20251001-v1:0"  # low-volume; unused until Epic 12

# --- Auth (Firebase — the last Google dependency) -------------------------------------------------
# Read by firebase-admin in apps/api. Optional in the schema, so every service boots without it,
# but REAL sign-in will not work unless it names a Firebase/Identity Platform project.
#
# You do not need it for local API work: with NODE_ENV=development the API accepts a dev token
# and never calls Firebase. See the README.
#
# This goes away in Phase 5, when Cognito replaces Firebase.
GOOGLE_CLOUD_PROJECT="project-signal-local"

# --- Apps -------------------------------------------------------------------------------------------
# DO NOT SET `PORT` HERE. All four backend apps load this same file, so a single PORT makes every
# one of them try to bind the same socket and `yarn dev` dies with EADDRINUSE. Each app already
# defaults to its own port when PORT is unset — api 8080, ingestion 8081, sentiment-worker 8082,
# report-worker 8083 — which is exactly what you want locally.
#
# In a deployed environment each container gets its own PORT, so setting it there is correct.
# It is only a shared local .env that breaks.
NODE_ENV=development
LOG_LEVEL=debug

# Comma-separated browser origins allowed to call the API. Unset = reflect any origin, which is
# safe here because auth is Bearer-only with no cookies or ambient credentials.
# CORS_ORIGINS="http://localhost:3000"

# --- Ingestion adapter credentials ------------------------------------------------------------------
# System-level, shared across all tenants; in a deployed environment these come from Secrets
# Manager, never from this file. Both are optional.
#
# Leave them blank and the RSS adapter still works — it needs no key, which is why it is the
# source to use for any end-to-end test. Without APIFY_API_KEY the Google Reviews, App Store and
# Play Store adapters cannot fetch; without YOUTUBE_API_KEY the YouTube adapter cannot.
APIFY_API_KEY=
YOUTUBE_API_KEY=
