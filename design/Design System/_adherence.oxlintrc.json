{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "brand/**",
              "core/**",
              "forms/**",
              "patterns/**",
              "shell/**",
              "ui_kits/lighthouse/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Open Sans|Poppins))/i]",
        "message": "Font not provided by the design system. Available: Open Sans, Poppins."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onNav|children|nav|pageTitle|user|notifications|persistAppearance|onAssistant|key|ref|className|style|children)$/]",
        "message": "<AppShell> doesn't accept that prop. Declared props: active, onNav, children, nav, pageTitle, user, notifications, persistAppearance, onAssistant."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|initial|size|gradient|radius|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, initial, size, gradient, radius."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|mosaic|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, mosaic."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:positive|info|warn|critical|neutral|teal)$/]",
        "message": "<Badge> tone must be one of 'positive' | 'info' | 'warn' | 'critical' | 'neutral' | 'teal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|iconLeft|iconRight|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, iconLeft, iconRight."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost|danger|subtle)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ghost' | 'danger' | 'subtle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:interactive|accent|padding|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: interactive, accent, padding."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|iconLeft|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: active, iconLeft."
      },
      {
        "selector": "JSXOpeningElement[name.name='ComposerSuggestion'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|key|ref|className|style|children)$/]",
        "message": "<ComposerSuggestion> doesn't accept that prop. Declared props: label, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|header|align|mono|wrap|render|key|ref|className|style|children)$/]",
        "message": "<DataColumn> doesn't accept that prop. Declared props: key, header, align, mono, wrap, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<DataColumn> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|action|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, description, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='Fab'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|key|ref|className|style|children)$/]",
        "message": "<Fab> doesn't accept that prop. Declared props: icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|stroke|strokeWidth|extraPaths|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, stroke, strokeWidth, extraPaths."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|as|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:input|textarea)$/]",
        "message": "<Input> as must be one of 'input' | 'textarea'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiTrend'] > JSXAttribute > JSXIdentifier[name!=/^(?:dir|value|tone|key|ref|className|style|children)$/]",
        "message": "<KpiTrend> doesn't accept that prop. Declared props: dir, value, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiTrend'] > JSXAttribute[name.name='dir'] > Literal[value!=/^(?:up|down)$/]",
        "message": "<KpiTrend> dir must be one of 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KpiTrend'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:positive|info|warn|critical|teal|neutral)$/]",
        "message": "<KpiTrend> tone must be one of 'positive' | 'info' | 'warn' | 'critical' | 'teal' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MosaicMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|gap|radius|key|ref|className|style|children)$/]",
        "message": "<MosaicMark> doesn't accept that prop. Declared props: size, gap, radius."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|action|key|ref|className|style|children)$/]",
        "message": "<PageHeader> doesn't accept that prop. Declared props: title, subtitle, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='PanelHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|tone|title|subtitle|action|key|ref|className|style|children)$/]",
        "message": "<PanelHeader> doesn't accept that prop. Declared props: icon, tone, title, subtitle, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='PanelHeader'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|lime|purple|teal|orange|magenta|neutral)$/]",
        "message": "<PanelHeader> tone must be one of 'blue' | 'lime' | 'purple' | 'teal' | 'orange' | 'magenta' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavEntry'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|icon|label|badge|badgeColor|key|ref|className|style|children)$/]",
        "message": "<NavEntry> doesn't accept that prop. Declared props: id, icon, label, badge, badgeColor."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|navy|accent|onSidebar|onAccent|accentOptions|notifications|user|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: title, navy, accent, onSidebar, onAccent, accentOptions, notifications, user."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
