# Operational alarms.
#
# Before 2026-11-16 the ONLY alerting in this stack was the budget. A dead-lettered scoring
# message, a crash-looping worker, a run of 5xx from the API or a database filling its disk all
# happened in silence — and the pipeline's whole history (KNOWN-GAPS #20, #23, #27) is defects
# that reported success while the feature was absent. These alarms make the failure modes that
# the system cannot report about itself page a human.
#
# Delivery: one SNS topic, emailed to the same addresses as the budget. An email subscription
# must be CONFIRMED by its recipient before SNS delivers to it — the owner receives an
# "AWS Notification - Subscription Confirmation" mail after the first apply (docs/OWNER-ACTIONS.md).
#
# Not encrypted with a KMS key: CloudWatch alarms cannot publish to a topic encrypted with the
# AWS-managed `alias/aws/sns` key, and a customer-managed key (~$1/month plus a key policy) is not
# provisioned in this stack. Alarm payloads carry metric names and thresholds, not data.
#
# Cost: CloudWatch standard-resolution alarms are $0.10/alarm/month; the set below is 13 alarms
# (3 DLQ + 2 ALB 5xx + 2 unhealthy-target + 4 ECS service + 2 RDS), ~$1.30/month. SNS email delivery at this volume is free-tier.

resource "aws_sns_topic" "alarms" {
  name = "${local.name_prefix}-alarms"
  tags = { Name = "${local.name_prefix}-alarms" }
}

resource "aws_sns_topic_subscription" "alarms_email" {
  for_each = toset(var.budget_notification_emails)

  topic_arn = aws_sns_topic.alarms.arn
  protocol  = "email"
  endpoint  = each.value
}

locals {
  alarm_actions = [aws_sns_topic.alarms.arn]
}

# ── Dead-letter queues ──────────────────────────────────────────────────────────────────────
#
# A message in a DLQ is a signal that failed five deliveries — evidence of a defect, never
# routine. Any message at all is worth an email.
resource "aws_cloudwatch_metric_alarm" "dlq_not_empty" {
  for_each = local.queues

  alarm_name        = "${local.name_prefix}-${each.value}-dlq-not-empty"
  alarm_description = "Messages in ${aws_sqs_queue.dlq[each.value].name}: a ${each.value} message failed 5 deliveries. Inspect, fix the cause, then redrive."
  namespace         = "AWS/SQS"
  metric_name       = "ApproximateNumberOfMessagesVisible"
  dimensions        = { QueueName = aws_sqs_queue.dlq[each.value].name }

  statistic           = "Maximum"
  period              = 300
  evaluation_periods  = 1
  comparison_operator = "GreaterThanThreshold"
  threshold           = 0
  treat_missing_data  = "notBreaching"

  alarm_actions = local.alarm_actions
  ok_actions    = local.alarm_actions
}

# ── Load balancer ───────────────────────────────────────────────────────────────────────────

resource "aws_cloudwatch_metric_alarm" "alb_target_5xx" {
  alarm_name        = "${local.name_prefix}-alb-target-5xx"
  alarm_description = "More than 5 HTTP 5xx responses from the API or web targets in 5 minutes."
  namespace         = "AWS/ApplicationELB"
  metric_name       = "HTTPCode_Target_5XX_Count"
  dimensions        = { LoadBalancer = aws_lb.main.arn_suffix }

  statistic           = "Sum"
  period              = 300
  evaluation_periods  = 1
  comparison_operator = "GreaterThanThreshold"
  threshold           = 5
  treat_missing_data  = "notBreaching"

  alarm_actions = local.alarm_actions
  ok_actions    = local.alarm_actions
}

resource "aws_cloudwatch_metric_alarm" "alb_elb_5xx" {
  alarm_name        = "${local.name_prefix}-alb-elb-5xx"
  alarm_description = "More than 5 HTTP 5xx generated by the load balancer itself in 5 minutes — usually no healthy target (502/503) or a target timing out (504)."
  namespace         = "AWS/ApplicationELB"
  metric_name       = "HTTPCode_ELB_5XX_Count"
  dimensions        = { LoadBalancer = aws_lb.main.arn_suffix }

  statistic           = "Sum"
  period              = 300
  evaluation_periods  = 1
  comparison_operator = "GreaterThanThreshold"
  threshold           = 5
  treat_missing_data  = "notBreaching"

  alarm_actions = local.alarm_actions
  ok_actions    = local.alarm_actions
}

resource "aws_cloudwatch_metric_alarm" "unhealthy_targets" {
  for_each = aws_lb_target_group.app

  alarm_name        = "${local.name_prefix}-${each.key}-unhealthy-targets"
  alarm_description = "A ${each.key} target has failed ALB health checks for 10 minutes."
  namespace         = "AWS/ApplicationELB"
  metric_name       = "UnHealthyHostCount"
  dimensions = {
    LoadBalancer = aws_lb.main.arn_suffix
    TargetGroup  = each.value.arn_suffix
  }

  statistic           = "Maximum"
  period              = 300
  evaluation_periods  = 2
  comparison_operator = "GreaterThanThreshold"
  threshold           = 0
  treat_missing_data  = "notBreaching"

  alarm_actions = local.alarm_actions
  ok_actions    = local.alarm_actions
}

# ── ECS services ────────────────────────────────────────────────────────────────────────────
#
# The workers have no target group, so the ALB alarms above cannot see them. Container Insights
# (enabled on the cluster) publishes RunningTaskCount per service; fewer running tasks than
# desired for ten minutes means a crash loop or a task ECS could not place. Missing data is
# BREACHING here — a service that has stopped reporting has stopped running.
resource "aws_cloudwatch_metric_alarm" "service_tasks_missing" {
  for_each = local.services

  alarm_name        = "${local.name_prefix}-${each.key}-tasks-below-desired"
  alarm_description = "${each.key} has fewer than ${each.value.desired} running task(s) for 10 minutes — crash loop or placement failure."
  namespace         = "ECS/ContainerInsights"
  metric_name       = "RunningTaskCount"
  dimensions = {
    ClusterName = aws_ecs_cluster.main.name
    ServiceName = aws_ecs_service.app[each.key].name
  }

  statistic           = "Minimum"
  period              = 300
  evaluation_periods  = 2
  comparison_operator = "LessThanThreshold"
  threshold           = each.value.desired
  treat_missing_data  = "breaching"

  alarm_actions = local.alarm_actions
  ok_actions    = local.alarm_actions
}

# ── Database ────────────────────────────────────────────────────────────────────────────────

resource "aws_cloudwatch_metric_alarm" "rds_cpu" {
  alarm_name        = "${local.name_prefix}-postgres-cpu-high"
  alarm_description = "RDS CPU above 80% for 15 minutes. db.t4g.micro is burstable: sustained load drains CPU credits and then throttles every query."
  namespace         = "AWS/RDS"
  metric_name       = "CPUUtilization"
  dimensions        = { DBInstanceIdentifier = aws_db_instance.main.identifier }

  statistic           = "Average"
  period              = 300
  evaluation_periods  = 3
  comparison_operator = "GreaterThanThreshold"
  threshold           = 80
  treat_missing_data  = "notBreaching"

  alarm_actions = local.alarm_actions
  ok_actions    = local.alarm_actions
}

resource "aws_cloudwatch_metric_alarm" "rds_free_storage" {
  alarm_name        = "${local.name_prefix}-postgres-free-storage-low"
  alarm_description = "Under 2 GiB free on RDS. Storage autoscaling (max_allocated_storage) should grow it first; if this fires, autoscaling has hit its ceiling."
  namespace         = "AWS/RDS"
  metric_name       = "FreeStorageSpace"
  dimensions        = { DBInstanceIdentifier = aws_db_instance.main.identifier }

  statistic           = "Minimum"
  period              = 300
  evaluation_periods  = 1
  comparison_operator = "LessThanThreshold"
  threshold           = 2147483648 # 2 GiB, in bytes
  treat_missing_data  = "notBreaching"

  alarm_actions = local.alarm_actions
  ok_actions    = local.alarm_actions
}
